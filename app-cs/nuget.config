<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- globalPackagesFolder 故意不钉死：默认落到 %USERPROFILE%\.nuget\packages，
       仓库贡献者按自己环境即可。维护者本机用 D:\dotnet\.nuget-packages，属本地覆盖。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
